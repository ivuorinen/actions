root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 200
tab_width = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# shfmt's own key, honored under its --apply-ignore flag: shfmt leaves the ShellSpec specs as written.
# editorconfig-checker does not read it, so the specs are still checked.
[{**/*.spec.sh}]
ignore = true

# Prettier owns Markdown indentation: it aligns an ordered list's continuation lines with the
# item's text, three spaces after "1. ", which no indent size divides.
[*.md]
indent_size = unset

# Each action's README is generated by `make docs`; its input tables run past any line length.
[*/README.md]
max_line_length = off

# The underscore directories hold no action, so their READMEs are written by hand.
[_*/README.md]
max_line_length = 200

# The findings tool writes this ledger, one JSON record per line.
[docs/audit/findings/*.jsonl]
max_line_length = off
