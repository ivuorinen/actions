{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ivuorinen/renovate-config",
    "customManagers:biomeVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned image tags in action env blocks. customManagers:githubActionsVersions reads '*_VERSION' keys, and has no digest group.",
      "managerFilePatterns": [
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+_IMAGE_TAG:\\s*'(?<currentValue>[^'@]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ]
    }
  ],
  "pinDigests": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    }
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "assignees": [
      "ivuorinen"
    ]
  }
}
