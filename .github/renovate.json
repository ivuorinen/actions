{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ivuorinen/renovate-config",
    "customManagers:biomeVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned image tags: YAML env keys in action.yml files, a shell variable in run-tests.sh. githubActionsVersions has no digest group.",
      "managerFilePatterns": [
        "/(^|/)action\\.ya?ml$/",
        "/^_tests/run-tests\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+_IMAGE_TAG:\\s*'(?<currentValue>[^'@]+)@(?<currentDigest>sha256:[a-f0-9]{64})'",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+_IMAGE_TAG='(?<currentValue>[^'@]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ]
    }
  ],
  "pinDigests": true,
  "platformAutomerge": true,
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.lock\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "CI never runs the lint tools these locks install, so a bump needs a person to try them.",
      "matchManagers": [
        "pip-compile"
      ],
      "automerge": false
    },
    {
      "description": "biome-lint, eslint-lint and prettier-lint install these npm locks with npm ci and run them on callers' code, so a bump needs a person to look at it.",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "biome-lint/package.json",
        "eslint-lint/package.json",
        "prettier-lint/package.json"
      ],
      "automerge": false
    },
    {
      "description": "Privileged images: docker-build starts binfmt with --privileged, and BuildKit builds for docker-build and docker-publish, so a person reviews each bump.",
      "matchDepNames": [
        "tonistiigi/binfmt",
        "moby/buildkit"
      ],
      "automerge": false
    },
    {
      "description": "Images pinned on a re-pushed tag move only by digest. The preset disables those outside github-actions, and a tag without a timestamp would wait for minimumReleaseAge forever.",
      "matchDepNames": [
        "catthehacker/ubuntu",
        "owasp/dependency-check-action"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": true,
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false
    }
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "assignees": [
      "ivuorinen"
    ]
  }
}
