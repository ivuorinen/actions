{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ivuorinen/renovate-config",
    "customManagers:biomeVersions"
  ],
  "pinDigests": true,
  "platformAutomerge": true,
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.lock\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "CI never runs the lint tools these locks install, so a bump needs a person to try them.",
      "matchManagers": [
        "pip-compile"
      ],
      "automerge": false
    }
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "assignees": [
      "ivuorinen"
    ]
  }
}
